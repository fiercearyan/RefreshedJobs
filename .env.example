# Apify API token — used server-side only by app/api/refresh/route.ts.
# Get yours at https://console.apify.com/account/integrations
# Copy this file to .env.local and fill in the value. NEVER commit .env.local.
APIFY_TOKEN=

# Optional: protect /api/refresh from public abuse. If set, requests must include
# ?token=<value> (or header x-refresh-token). Leave blank to disable.
REFRESH_SECRET=
