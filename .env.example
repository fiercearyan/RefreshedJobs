# ---- Apify ----
# Shared fallback token, used server-side when a signed-in user has NOT added
# their own key in their profile. Get yours at:
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# ---- Auth (NextAuth / Google) ----
# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the app. Local: http://localhost:3000 — on Vercel: your deployment URL.
NEXTAUTH_URL=http://localhost:3000
# Random secret for signing session JWTs. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Database ----
# MongoDB Atlas connection string (free M0 tier is fine).
# e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jobboard?retryWrites=true&w=majority
MONGODB_URI=

# ---- Encryption ----
# Secret used to encrypt each user's Apify key at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=

# ---- Optional ----
# If set, /api/refresh also requires ?token=<value> or x-refresh-token header.
REFRESH_SECRET=
